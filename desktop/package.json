{
  "name": "udd-desktop",
  "productName": "UDD",
  "version": "1.0.0",
  "description": "UDD - 统一数据展示系统（桌面版）",
  "author": "UDD",
  "private": true,
  "main": "main.js",
  "scripts": {
    "icon": "node build-icon.js",
    "start": "electron .",
    "pack": "node build-icon.js && electron-builder --win dir",
    "dist": "node build-icon.js && electron-builder --win dir && node edit-exe.js && electron-builder --win nsis portable --prepackaged release20/win-unpacked",
    "pack:mac": "node build-icon.js && electron-builder --mac dir",
    "dist:mac": "node build-icon.js && electron-builder --mac dmg zip",
    "dist:mac:x64": "node build-icon.js && electron-builder --mac dmg zip --x64"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.udd.desktop.v2",
    "productName": "UDD",
    "copyright": "Copyright © UDD",
    "directories": {
      "output": "release20",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../udd-app.html",
        "to": "udd-web/udd-app.html"
      },
      {
        "from": "../server.js",
        "to": "udd-web/server.js"
      },
      {
        "from": "../accounts-lib.js",
        "to": "udd-web/accounts-lib.js"
      },
      {
        "from": "../space-lib.js",
        "to": "udd-web/space-lib.js"
      },
      {
        "from": "../css",
        "to": "udd-web/css"
      },
      {
        "from": "../js",
        "to": "udd-web/js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "UDD"
    },
    "portable": {
      "artifactName": "UDD-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "UDD-${version}-${arch}.${ext}",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "UDD 需要访问「文档」目录，用于打开和保存你的数据文档。",
        "NSDownloadsFolderUsageDescription": "UDD 需要访问「下载」目录，用于打开下载的数据文档。",
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "UDD 统一数据文档",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSItemContentTypes": [
              "com.udd.document"
            ],
            "CFBundleTypeExtensions": [
              "udd"
            ]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.udd.document",
            "UTTypeDescription": "UDD 统一数据文档",
            "UTTypeConformsTo": [
              "public.data",
              "public.content"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "udd"
              ]
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "UDD ${version}",
      "artifactName": "UDD-${version}-${arch}.dmg"
    }
  }
}
